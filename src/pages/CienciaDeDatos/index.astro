---
import Layout from '../../layouts/Layout.astro';
import CategoryLanding from '../../components/CategoryLanding.jsx';
---

<Layout title="Ciencia de Datos" description="Apuntes de ciencia de datos: machine learning, estadísticas, pandas, numpy y big data.">
  <CategoryLanding
    client:load
    category="ciencia-de-datos"
    title="Ciencia de Datos"
    description="Machine Learning, Big Data, Data Warehouse, Business Intelligence y análisis práctico."
    icon="BookOpen"
    topics={[
      { label: "1. Introducción a la Ciencia de Datos", path: "/CienciaDeDatos/Introduccion" },
      { label: "2. Manipulación de Datos (Pandas & NumPy)", path: "/CienciaDeDatos/PandasNumPy" },
      { label: "3. Análisis Exploratorio de Datos (EDA)", path: "/CienciaDeDatos/EDA" },
      { label: "4. Machine Learning: Aprendizaje Supervisado", path: "/CienciaDeDatos/Supervisado" },
      { label: "5. Machine Learning: Aprendizaje No Supervisado", path: "/CienciaDeDatos/NoSupervisado" },
      { label: "6. Data Warehouse & ETL", path: "/CienciaDeDatos/DataWarehouse" },
      { label: "7. Big Data & Procesamiento Masivo", path: "/CienciaDeDatos/BigData" },
      { label: "8. Inteligencia de Negocios (BI)", path: "/CienciaDeDatos/BusinessIntelligence" },
      { label: "9. Operaciones con Python", path: "/CienciaDeDatos/PythonOperaciones" },
      { label: "10. Glosario de Ciencia de Datos", path: "/CienciaDeDatos/Glosario" }
    ]}
  />
</Layout>
