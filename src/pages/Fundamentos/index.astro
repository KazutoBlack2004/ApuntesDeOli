---
import Layout from '../../layouts/Layout.astro';
import CategoryLanding from '../../components/CategoryLanding.jsx';
---

<Layout title="Fundamentos de Informática" description="Bases conceptuales del software: APIs, formatos de archivos, gestores de paquetes y unidades de información.">
  <CategoryLanding
    client:load
    category="fundamentos"
    title="Fundamentos"
    description="Conceptos base para entender informática, redes, datos y sistemas."
    icon="BookOpen"
    topics={[
      { label: "Unidades de información", path: "/Fundamentos/UnidadesDeInformacion" },
      { label: "¿Qué es una API?", path: "/Fundamentos/QueEsUnaAPI" },
      { label: "Formato JSON", path: "/Fundamentos/FormatoJSON" },
      { label: "¿Qué es NPM?", path: "/Fundamentos/QueEsNPM" },
      { label: "Operaciones CRUD", path: "/Fundamentos/CrudOperaciones" },
      { label: "Tokens y JWT", path: "/Fundamentos/TokensYJWT" },
    ]}
  />
</Layout>
