---
import Layout from '../../layouts/Layout.astro';
import CategoryLanding from '../../components/CategoryLanding.jsx';
---

<Layout title="Desarrollo de Software" description="Patrones de diseño, arquitecturas, metodologías ágiles, control de versiones y mejores prácticas.">
  <CategoryLanding
    client:load
    category="desarrollo-software"
    title="Desarrollo de Software"
    description="Algoritmos, estructuras de datos, patrones de diseño y arquitecturas."
    icon="Code"
    topics={[
      { label: "Git y Convenciones de Commits", path: "/DesarrolloSoftware/ConvencionesCommits" },
      { label: "Programación Orientada a Objetos (POO)", path: "/DesarrolloSoftware/POO" },
      { label: "Frameworks y Librerías", path: "/DesarrolloSoftware/FrameworksYLibrerias" },
      { label: "SEO para Desarrollo Web", path: "/DesarrolloSoftware/SEO" },
      { label: "Optimización de Imágenes", path: "/DesarrolloSoftware/OptimizacionImagenes" },
      { label: "Estilos de Interfaz (UI)", path: "/DesarrolloSoftware/EstilosUI" },
      { label: "Paletas de Colores", path: "/DesarrolloSoftware/PaletasColores" },
      { label: "Convenciones de Nombres", path: "/DesarrolloSoftware/ConvencionesNombres" },
      { label: "Seguridad y Escalabilidad", path: "/DesarrolloSoftware/SeguridadYEscalabilidad" },
      { label: "Testing de Software", path: "/DesarrolloSoftware/Testing" },
    ]}
  />
</Layout>
