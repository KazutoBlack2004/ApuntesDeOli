---
import Layout from '../../layouts/Layout.astro';
import CategoryLanding from '../../components/CategoryLanding.jsx';
---

<Layout>
  <CategoryLanding
    client:load
    category="redes"
    title="Redes"
    description="Protocolos, modelos OSI/TCP-IP, direccionamiento IPv4/IPv6, subnetting y más."
    icon="Network"
    topics={[
      { label: "Tipos de IP (IPv4 / IPv6)", path: "/Redes/TiposDeIP", badge: "Nuevo" },
      { label: "Máscara de red y gateway", path: "/Redes/MascaraGateway", badge: "Nuevo" },
      { label: "Interfaces de red", path: "/Redes/InterfacesDeRed", badge: "Nuevo" },
      { label: "Cálculo de redes", path: "/Redes/CalculoDeRedes", badge: "Nuevo" },
      { label: "Modelo OSI", path: "/Redes/ModeloOSI" },
      { label: "TCP/IP", path: "/Redes/TCPIP" },
      { label: "Subnetting y CIDR", path: "/Redes/Subnetting" },
    ]}
  />
</Layout>
