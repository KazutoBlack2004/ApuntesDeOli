---
import Layout from '../../layouts/Layout.astro';
import CategoryLanding from '../../components/CategoryLanding.jsx';
---

<Layout>
  <CategoryLanding
    client:load
    category="redes"
    title="Redes"
    description="Protocolos, modelos OSI/TCP-IP, direccionamiento IPv4/IPv6, subnetting y más."
    icon="Network"
    topics={[
      { label: "Tipos de IP (IPv4 / IPv6)", path: "/Redes/TiposDeIP" },
      { label: "Máscara de red y gateway", path: "/Redes/MascaraGateway" },
      { label: "Interfaces de red", path: "/Redes/InterfacesDeRed" },
      { label: "Modelos de red (OSI / TCP-IP)", path: "/Redes/ModelosRedes" },
      { label: "Dispositivos y protocolos", path: "/Redes/ProtocolosDispositivos" },
      { label: "Cálculo de redes", path: "/Redes/CalculoDeRedes" },
      { label: "VLANs y enrutamiento básico", path: "/Redes/VlansEnrutamiento" },
      { label: "Códigos de estado HTTP", path: "/Redes/CodigosHTTP" },
    ]}
  />
</Layout>
